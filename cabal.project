packages: .

-- nano-ui is not on Hackage; build it from GitHub. The tag pins the commit
-- that was HEAD of goolord/nano-ui main when this was written. To move to a
-- newer HEAD:  git ls-remote https://github.com/goolord/nano-ui HEAD
source-repository-package
  type: git
  location: https://github.com/goolord/nano-ui.git
  tag: 2e918df6975486cd92a0ddef30f4ccfffb247ff9
  subdir:
    packages/nano-ui
    packages/nano-ui-emit
    packages/nano-ui-sdl
    packages/nano-ui-svg

package nano-ui-sdl
  flags: +sdl

tests: True
