cabal-version:      3.4
name:               stronghead
version:            0.1.0.0
synopsis:           A live debugger and profiler GUI for GHC programs
description:
    Stronghead is an immediate-mode GUI (built on nano-ui) for the opaque
    parts of running Haskell: eventlog timelines (capabilities, threads, GC),
    heap profiles and space-leak hunting, Core/STG dump inspection, a GHCi
    breakpoint stepper, and a live RTS stats dashboard fed by a drop-in agent.
license:            MIT
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Development, Profiling, Debug
build-type:         Simple
extra-doc-files:    README.md

-- The ghc-debug backend for the heap panel: live closure graphs and exact
-- retainer paths from a program running ghc-debug-stub. The client builds on
-- every platform ghc-debug-client does (Windows included); the stub, which
-- the target links, needs Unix sockets and does not build on Windows.
flag ghc-debug
    description: Build the ghc-debug backend (live closure graphs, exact retainer paths)
    default:     False
    manual:      True

common extensions
    default-language: GHC2024
    default-extensions:
        DuplicateRecordFields
        LambdaCase
        MultiWayIf
        OverloadedStrings
        RecordWildCards
        StrictData

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wpartial-fields
        -Wredundant-constraints
        -Wno-name-shadowing

-- Parsers and models for every artifact the GUI reads. No GUI dependency,
-- so it can be tested and reused headlessly.
library
    import:           extensions, warnings
    hs-source-dirs:   src
    exposed-modules:
        Stronghead.Eventlog
        Stronghead.Eventlog.Model
        Stronghead.HeapProfile
        Stronghead.Prof
        Stronghead.Dump
        Stronghead.Ghci
        Stronghead.Live
        Stronghead.Source
        Stronghead.Run
        Stronghead.Ref
        Stronghead.Join
        Stronghead.Fuzzy
        Stronghead.Format
        Stronghead.Debug
        Stronghead.Debug.Graph
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.9,
        directory ^>=1.3,
        filepath >=1.4 && <1.6,
        ghc-events >=0.20 && <0.22,
        network >=3.1 && <3.3,
        process ^>=1.6,
        text >=2.0 && <2.2,
        vector >=0.13 && <0.14
    if flag(ghc-debug)
        other-modules:  Stronghead.Debug.Client
        cpp-options:    -DGHC_DEBUG
        build-depends:
            contra-tracer ^>=0.2,
            ghc-debug-client ^>=0.8,
            ghc-debug-common ^>=0.8,
            ghc-debug-convention ^>=0.8,
            time >=1.12 && <1.16

-- The drop-in agent a target program links to publish live RTS stats.
-- Deliberately tiny: base and network only.
library agent
    import:           extensions, warnings
    visibility:       public
    hs-source-dirs:   agent
    exposed-modules:  Stronghead.Agent
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.11 && <0.13,
        network >=3.1 && <3.3

executable stronghead
    import:           extensions, warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:
        UI.Code
        UI.Common
        UI.Timeline
        UI.Heap
        UI.Core
        UI.Debugger
        UI.Link
        UI.Live
        UI.Palette
        UI.Settings
        UI.Shell
    build-depends:
        base >=4.20 && <4.23,
        containers >=0.6 && <0.9,
        directory ^>=1.3,
        filepath >=1.4 && <1.6,
        nano-ui ^>=0.2,
        nano-ui-sdl ^>=0.2,
        process ^>=1.6,
        stronghead,
        text >=2.0 && <2.2,
        vector >=0.13 && <0.14
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N2 -A64m -I0"
    if os(windows)
        ghc-options: -optl-mconsole

-- A deliberately misbehaving program: contended MVars, labelled threads, a
-- lazy accumulator space leak. Run it to produce an eventlog, a heap profile
-- and live stats to look at.
executable stronghead-sample
    import:           extensions, warnings
    hs-source-dirs:   sample
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.23,
        containers >=0.6 && <0.9,
        stronghead:agent
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4 -T"
    -- With the flag, the sample also runs ghc-debug-stub so the heap panel's
    -- live graph has something to connect to. The stub is Unix-only.
    if flag(ghc-debug) && !os(windows)
        cpp-options:   -DGHC_DEBUG_STUB
        build-depends: ghc-debug-stub ^>=0.8

-- The links between panels, driven headlessly through nano-ui's test
-- harness. Builds the GUI modules it needs from app/.
test-suite stronghead-ui-test
    import:           extensions, warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test-ui app
    main-is:          Main.hs
    other-modules:
        UI.Code
        UI.Common
        UI.Link
        UI.Palette
    build-depends:
        base >=4.20 && <4.23,
        containers >=0.6 && <0.9,
        filepath >=1.4 && <1.6,
        nano-ui ^>=0.2,
        stronghead,
        text >=2.0 && <2.2
    ghc-options:      -threaded

test-suite stronghead-test
    import:           extensions, warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.23,
        containers >=0.6 && <0.9,
        filepath >=1.4 && <1.6,
        ghc-events >=0.20 && <0.22,
        stronghead,
        text >=2.0 && <2.2,
        vector >=0.13 && <0.14
    ghc-options:      -threaded
