cabal-version:      3.4
name:               stronghead
version:            0.1.0.0
synopsis:           A profiler and debugger GUI for GHC programs
description:
    Stronghead is a GUI profiler and debugger for GHC programs built on
    nano-ui. It includes an eventlog timeline viewer, heap profiler, Core/STG
    dump viewer, GHCi debugger frontend, and live RTS telemetry monitor.
license:            MIT
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Development, Profiling, Debug
build-type:         Simple
extra-doc-files:    README.md

-- The ghc-debug backend for the heap panel: live closure graphs and exact
-- retainer paths from a program running ghc-debug-stub. The client builds on
-- every platform ghc-debug-client does (Windows included); the stub, which
-- the target links, needs Unix sockets and does not build on Windows.
flag ghc-debug
    description: Build the ghc-debug backend (live closure graphs, exact retainer paths)
    default:     False
    manual:      True

common extensions
    default-language: GHC2024
    default-extensions:
        BlockArguments
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        MultiWayIf
        MultilineStrings
        OverloadedStrings
        RecordWildCards
        StrictData

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wpartial-fields
        -Wredundant-constraints
        -Wno-name-shadowing

-- Parsers and models for every artifact the GUI reads. No GUI dependency,
-- so it can be tested and reused headlessly.
library
    import:           extensions, warnings
    hs-source-dirs:   src
    exposed-modules:
        Stronghead.Eventlog
        Stronghead.Eventlog.Model
        Stronghead.HeapProfile
        Stronghead.Prof
        Stronghead.Dump
        Stronghead.Ghci
        Stronghead.Live
        Stronghead.Attach
        Stronghead.Source
        Stronghead.Run
        Stronghead.Clock
        Stronghead.Ref
        Stronghead.Session
        Stronghead.Join
        Stronghead.Next
        Stronghead.Watch
        Stronghead.Diff
        Stronghead.Fuzzy
        Stronghead.Format
        Stronghead.Markdown
        Stronghead.TextFile
        Stronghead.Debug
        Stronghead.Debug.Graph
    build-depends:
        async >=2.2 && <2.3,
        base >=4.20 && <4.23,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.9,
        directory ^>=1.3,
        extra >=1.7 && <1.9,
        filepath >=1.4 && <1.6,
        ghc-events >=0.20 && <0.22,
        megaparsec >=9.5 && <9.9,
        mtl >=2.2 && <2.4,
        network >=3.1 && <3.3,
        process ^>=1.6,
        stm >=2.5 && <2.6,
        text >=2.0 && <2.2,
        vector >=0.13 && <0.14
    if flag(ghc-debug)
        other-modules:  Stronghead.Debug.Client
        cpp-options:    -DGHC_DEBUG
        build-depends:
            contra-tracer ^>=0.2,
            ghc-debug-client ^>=0.8,
            ghc-debug-common ^>=0.8,
            ghc-debug-convention ^>=0.8,
            time >=1.12 && <1.16

-- The drop-in agent a target program links to publish live RTS stats.
-- Deliberately tiny: base and network only.
library agent
    import:           extensions, warnings
    visibility:       public
    hs-source-dirs:   agent
    exposed-modules:  Stronghead.Agent
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.11 && <0.13,
        network >=3.1 && <3.3

-- The graphical user interface and headless SVG export library.
library ui
    import:           extensions, warnings
    visibility:       public
    hs-source-dirs:   app
    exposed-modules:
        Demo
        UI.Baseline
        UI.Clock
        UI.Code
        UI.Common
        UI.Timeline
        UI.Heap
        UI.Core
        UI.Debugger
        UI.Graph
        UI.Inspector
        UI.Link
        UI.Live
        UI.Palette
        UI.Pinboard
        UI.Settings
        UI.Shell
        UI.Sources
        UI.Watchers
        UI.Workspace
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.9,
        directory ^>=1.3,
        extra >=1.7 && <1.9,
        filepath >=1.4 && <1.6,
        megaparsec >=9.5 && <9.9,
        mtl >=2.2 && <2.4,
        nano-ui ^>=0.2,
        nano-ui-sdl ^>=0.2,
        nano-ui-svg ^>=0.1,
        optparse-applicative >=0.18 && <0.20,
        primitive ^>=0.9,
        process ^>=1.6,
        stronghead,
        text >=2.0 && <2.2,
        time >=1.12 && <1.16,
        vector >=0.13 && <0.14

-- The Model Context Protocol (MCP) server library for AI assistants.
library mcp
    import:           extensions, warnings
    visibility:       public
    hs-source-dirs:   mcp
    exposed-modules:
        Stronghead.MCP.Types
        Stronghead.MCP.Tools
        Stronghead.MCP.Server
    build-depends:
        async >=2.2 && <2.3,
        base >=4.20 && <4.23,
        containers >=0.6 && <0.9,
        directory ^>=1.3,
        filepath >=1.4 && <1.6,
        mcp-server >=0.2 && <0.4,
        stronghead,
        stronghead:ui,
        text >=2.0 && <2.2,
        vector >=0.13 && <0.14

executable stronghead
    import:           extensions, warnings
    hs-source-dirs:   app-bin
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.23,
        nano-ui ^>=0.2,
        nano-ui-sdl ^>=0.2,
        optparse-applicative >=0.18 && <0.20,
        stronghead:ui,
        text >=2.0 && <2.2
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N2 -A64m -I0"
    if os(windows)
        ghc-options: -optl-mconsole

-- Standalone Model Context Protocol (MCP) server for AI assistants
executable stronghead-mcp
    import:           extensions, warnings
    hs-source-dirs:   app-mcp
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.23,
        stronghead:mcp
    ghc-options:      -threaded -rtsopts

-- Sample program with MVar contention, a lazy accumulator leak, and an
-- unbounded map for testing profiling and debugging views.
executable stronghead-sample
    import:           extensions, warnings
    hs-source-dirs:   sample
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.23,
        containers >=0.6 && <0.9,
        stronghead:agent
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4 -T"
    -- With the flag, the sample also runs ghc-debug-stub so the heap panel's
    -- live graph has something to connect to. The stub is Unix-only.
    if flag(ghc-debug) && !os(windows)
        cpp-options:   -DGHC_DEBUG_STUB
        build-depends: ghc-debug-stub ^>=0.8

-- The links between panels, driven headlessly through nano-ui's test
-- harness. Builds the GUI modules it needs from app/.
test-suite stronghead-ui-test
    import:           extensions, warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test-ui
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.23,
        containers >=0.6 && <0.9,
        directory ^>=1.3,
        extra >=1.7 && <1.9,
        filepath >=1.4 && <1.6,
        megaparsec >=9.5 && <9.9,
        mtl >=2.2 && <2.4,
        nano-ui ^>=0.2,
        nano-ui-sdl ^>=0.2,
        process ^>=1.6,
        stronghead,
        stronghead:ui,
        text >=2.0 && <2.2,
        time >=1.12 && <1.16,
        vector >=0.13 && <0.14
    ghc-options:      -threaded

test-suite stronghead-test
    import:           extensions, warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.9,
        directory ^>=1.3,
        extra >=1.7 && <1.9,
        filepath >=1.4 && <1.6,
        ghc-events >=0.20 && <0.22,
        network >=3.1 && <3.3,
        stronghead,
        stronghead:agent,
        stronghead:mcp,
        text >=2.0 && <2.2,
        vector >=0.13 && <0.14
    ghc-options:      -threaded
